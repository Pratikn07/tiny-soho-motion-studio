{
  "name": "tiny-soho-creative-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=24" },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "concurrently --kill-others-on-fail \"next dev --hostname 127.0.0.1 --port 3001\" \"tsx server/worker.ts\"",
    "build": "next build",
    "start": "concurrently --kill-others-on-fail \"next start --hostname 127.0.0.1 --port 3001\" \"tsx server/worker.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "better-sqlite3": "^12.2.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
