{
  "name": "tiny-soho-creative-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "concurrently --kill-others-on-fail \"next dev --hostname 127.0.0.1 --port 3001\" \"tsx server/worker.ts\"",
    "build": "next build",
    "start": "concurrently --kill-others-on-fail \"next start --hostname 127.0.0.1 --port 3001\" \"tsx server/worker.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "lint": "next lint",
    "vision:doctor": "python3 -m services.vision.vision_doctor",
    "vision:start": "python3 -m services.vision.app",
    "vision:smoke": "python3 -m services.vision.ocr_smoke",
    "vision:compose:smoke": "python3 -m services.vision.compose_smoke",
    "vision:sam2:smoke": "python3 -m services.vision.sam2_smoke",
    "vision:qwen:smoke": "python3 -m services.vision.qwen_layers_smoke",
    "verify:vision-repository": "tsx scripts/verify-vision-repository.ts",
    "media:probe-bailian": "tsx scripts/probe-bailian-transport.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.6",
    "better-sqlite3": "^12.2.0",
    "next": "^15.5.24",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "8.5.28",
    "nanoid": "3.3.19"
  }
}
