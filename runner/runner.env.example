# Copy to ~/.config/tiny-soho/runner.env and keep it private (chmod 600).
TINY_SOHO_STUDIO_URL=https://tiny-soho-creative-studio.vercel.app
# Same value as the TINY_SOHO_RUNNER_TOKEN Vercel variable (at least 32 characters).
TINY_SOHO_RUNNER_TOKEN=
TINY_SOHO_RUNNER_ID=studio-mac
TINY_SOHO_RUNNER_LABEL=Studio Mac
# subscription (your Claude login) now; api_key once creators join.
TINY_SOHO_CLAUDE_AUTH=subscription
# Voice step: your ElevenLabs API key and the id of your cloned voice ("nabel v1" is zLp4KiBCb1rw1aPSh4E1).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Build, Sound and Export: Studio's copy of the motion engine (a git worktree on branch `studio`). Leave empty for
# ~/Documents/working/mch/tiny-soho-reels-studio.
TINY_SOHO_ENGINE_DIR=
# Are.na boards: the Mac finds or creates "Tiny Soho · <Series>" on your Are.na account and adds pins for each reel.
# Set to off to stop it (links you add yourself are still read).
TINY_SOHO_ARENA_BOARDS=
