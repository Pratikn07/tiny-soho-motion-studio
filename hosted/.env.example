NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TINY_SOHO_STUDIO_ADMIN_EMAILS=

# Server-only release flag. true opens creation at /; false retains the old default.
TINY_SOHO_CREATIONS_V2=false

# Optional, server-only: HTTPS origin of the creative-worker billing read endpoint.
# Modal tokens stay on the worker. Uses the existing shared Supabase server key to sign reads.
CREATIVE_WORKER_BILLING_URL=

# Optional image understanding. Server-only; configure both to enable suggestions.
NVIDIA_API_KEY=
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Creation motion reviewer. Server-only; NVIDIA remains the default provider.
# For Gemini set REVIEW_PROVIDER=gemini, REVIEW_MODEL=gemini-3.5-flash-lite, and GEMINI_API_KEY.
REVIEW_PROVIDER=nvidia
REVIEW_MODEL=
GEMINI_API_KEY=
