# Singapore workspace credentials. Keep real values only in .env.
DASHSCOPE_API_KEY=
ALIBABA_WORKSPACE_ID=
PORT=3001
TINY_SOHO_DATA_DIR=
FFMPEG_PATH=
FFPROBE_PATH=

# Private Tiny Soho knowledge is off unless all three server-only values are set.
# Use a dedicated tiny_soho_studio_reader Postgres URL; never use a Supabase
# publishable/anon/service-role key here. The CA path must be absolute; do not
# append sslmode because the server verifies TLS explicitly with that CA.
TINY_SOHO_KNOWLEDGE_ENABLED=false
TINY_SOHO_KNOWLEDGE_DATABASE_URL=
TINY_SOHO_KNOWLEDGE_DATABASE_CA_PATH=
