# Singapore workspace credentials. Keep real values only in .env.
DASHSCOPE_API_KEY=
ALIBABA_WORKSPACE_ID=
PORT=3001
TINY_SOHO_DATA_DIR=
FFMPEG_PATH=
FFPROBE_PATH=

# Optional local-only Vision sidecar. These values are not provider credentials.
TINY_SOHO_VISION_PORT=8765
TINY_SOHO_VISION_CACHE_DIR=
TINY_SOHO_VISION_ARTIFACT_TTL_SECONDS=86400
TINY_SOHO_VISION_MAX_UPLOAD_BYTES=16777216
TINY_SOHO_VISION_MAX_IMAGE_ARTIFACT_BYTES=67108864
TINY_SOHO_VISION_MAX_VIDEO_ARTIFACT_BYTES=1073741824
TINY_SOHO_VISION_MAX_IMAGE_PIXELS=40000000

# Optional real local OCR. Install its optional runtime and provision the pinned
# models into an owner-controlled directory outside this repository first.
# The sidecar never downloads model weights at startup.
TINY_SOHO_PADDLE_OCR_ENABLED=0
TINY_SOHO_PADDLE_OCR_PROFILE=v5-mobile
TINY_SOHO_PADDLE_OCR_DET_MODEL_DIR=
TINY_SOHO_PADDLE_OCR_REC_MODEL_DIR=
TINY_SOHO_PADDLE_OCR_LANGUAGE=en
TINY_SOHO_PADDLE_OCR_TIMEOUT_SECONDS=30

# Optional real local segmentation. The checkpoint must be provisioned outside
# this repository. `auto` prefers CUDA, then MPS, then CPU after runtime checks.
TINY_SOHO_SAM2_ENABLED=0
TINY_SOHO_SAM2_CHECKPOINT_PATH=
TINY_SOHO_SAM2_MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
TINY_SOHO_SAM2_DEVICE=auto
TINY_SOHO_SAM2_TIMEOUT_SECONDS=45

# Enhanced-only Qwen Image Layered. Use one explicitly reviewed backend; never
# expose the remote token to the browser and never point it at an arbitrary URL.
TINY_SOHO_QWEN_LAYERS_ENABLED=0
TINY_SOHO_QWEN_LAYERS_BACKEND=disabled
TINY_SOHO_QWEN_LAYERS_MODEL_PATH=
TINY_SOHO_QWEN_LAYERS_REMOTE_URL=
TINY_SOHO_QWEN_LAYERS_REMOTE_TOKEN=
TINY_SOHO_QWEN_LAYERS_REMOTE_ALLOWED_HOSTS=
TINY_SOHO_QWEN_LAYERS_TIMEOUT_SECONDS=60
TINY_SOHO_QWEN_LAYERS_MIN_FREE_VRAM_BYTES=17179869184

# Private Tiny Soho knowledge is off unless all three server-only values are set.
# Use a dedicated tiny_soho_studio_reader Postgres URL; never use a Supabase
# publishable/anon/service-role key here. The CA path must be absolute; do not
# append sslmode because the server verifies TLS explicitly with that CA.
TINY_SOHO_KNOWLEDGE_ENABLED=false
TINY_SOHO_BAILIAN_TEMPORARY_UPLOAD_CAPABILITY=
# Owner-run no-generation probe only. The app never runs this probe itself and
# no temporary locator is printed or written to disk.
TINY_SOHO_BAILIAN_CLI_PATH=
TINY_SOHO_BAILIAN_PROBE_CONFIRM=
TINY_SOHO_BAILIAN_PROBE_EXPIRY_SECONDS=
TINY_SOHO_KNOWLEDGE_DATABASE_URL=
TINY_SOHO_KNOWLEDGE_DATABASE_CA_PATH=
